{
  "Frontend": {
    "BaseUrl": "http://localhost:5173"
  },
  "Email": {
    "Mode": "DevelopmentFile"
  },
  "RateLimiting": {
    "Account": {
      "Login": {
        "PermitLimit": 10000,
        "WindowSeconds": 60
      },
      "ForgotPassword": {
        "PermitLimit": 10000,
        "WindowSeconds": 60
      },
      "AcceptInvitation": {
        "PermitLimit": 10000,
        "WindowSeconds": 60
      },
      "ResetPassword": {
        "PermitLimit": 10000,
        "WindowSeconds": 60
      },
      "ChangePassword": {
        "PermitLimit": 10000,
        "WindowSeconds": 60
      }
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
