{
  "AccountLifecycle": {
    "InvitationExpirationHours": 24,
    "PasswordResetExpirationMinutes": 60
  },
  "Frontend": {
    "BaseUrl": ""
  },
  "Email": {
    "Mode": "Smtp",
    "Host": "",
    "Port": 587,
    "Username": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "Maintenance Request System",
    "EnableSsl": true
  },
  "RateLimiting": {
    "Account": {
      "Login": {
        "PermitLimit": 20,
        "WindowSeconds": 60
      },
      "ForgotPassword": {
        "PermitLimit": 10,
        "WindowSeconds": 60
      },
      "AcceptInvitation": {
        "PermitLimit": 20,
        "WindowSeconds": 60
      },
      "ResetPassword": {
        "PermitLimit": 20,
        "WindowSeconds": 60
      },
      "ChangePassword": {
        "PermitLimit": 10,
        "WindowSeconds": 60
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
